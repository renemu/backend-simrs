# Application Settings
APP_ID=simrs-backend-yii2
APP_NAME="SIMRS Backend API (Yii2)"
APP_VERSION=1.0.0
APP_ENV=dev
APP_DEBUG=true
COOKIE_VALIDATION_KEY=change-this-cookie-validation-key

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=simrs_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_CHARSET=utf8
DB_SCHEMA_CACHE=false
DB_SCHEMA_CACHE_DURATION=60

# JWT Authentication
JWT_SECRET=change-this-jwt-secret-key-in-production
JWT_TTL=604800

# Mailer Configuration
ADMIN_EMAIL=admin@example.com
SENDER_EMAIL=noreply@example.com
SENDER_NAME="SIMRS Mailer"
