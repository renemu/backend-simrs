parameters:
    level: 5
    treatPhpDocTypesAsCertain: false

    paths:
        - commands
        - components
        - controllers
        - models
        - seeders

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    tmpDir: %currentWorkingDirectory%/runtime
