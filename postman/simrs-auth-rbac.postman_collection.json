{
  "info": {
    "name": "SIMRS Inova Medika — Auth, Users, Roles, Modules & Audit Logs",
    "description": "Postman collection untuk verifikasi fondasi Auth JWT, RBAC 6 Role SIMRS, Users, Roles, Modules, dan Activity Logs pada backend-yii2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health & Auth",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/"
          }
        },
        {
          "name": "POST Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Token returned', () => pm.expect(json.data.token).to.be.a('string'));",
                  "pm.environment.set('admin_token', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "POST Login (Doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('doctor_token', json.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"doctor@example.com\",\n  \"password\": \"dokter123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "POST Public Register (Expect 403 Disabled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Public self-registration blocked with 403', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attacker@example.com\",\n  \"password\": \"secret123\",\n  \"role_id\": 1\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "GET Auth Me (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/auth/me"
          }
        },
        {
          "name": "GET Check Permission (Doctor on users-list -> false)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": "{{base_url}}/api/auth/permissions?module_code=users-list&action=read"
          }
        }
      ]
    },
    {
      "name": "2. Authorization Boundary (Negative Tests)",
      "item": [
        {
          "name": "GET Users without Token (Expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Unauthenticated returns 401', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/users"
          }
        },
        {
          "name": "GET Users as Doctor (Expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Doctor forbidden from users-list (403)', () => pm.response.to.have.status(403));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{doctor_token}}" }
            ],
            "url": "{{base_url}}/api/users"
          }
        },
        {
          "name": "DELETE Core Role Admin (Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Core role deletion blocked with 409', () => pm.response.to.have.status(409));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/roles/1"
          }
        }
      ]
    },
    {
      "name": "3. Users, Roles, Modules & Audit Logs (Admin)",
      "item": [
        {
          "name": "GET Users (Paginated)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/users?page=1&per_page=10"
          }
        },
        {
          "name": "POST Create User (Expect 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('created_user_id', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"dr. Demo Verifikasi\",\n  \"email\": \"demo.dokter@example.com\",\n  \"role_id\": 3,\n  \"password\": \"secret123\",\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/users"
          }
        },
        {
          "name": "DELETE Soft Delete Created User (Expect 200)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/users/{{created_user_id}}"
          }
        },
        {
          "name": "GET Roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/roles"
          }
        },
        {
          "name": "GET Modules Tree",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/modules/tree"
          }
        },
        {
          "name": "GET Activity Logs (Audit Trail)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": "{{base_url}}/api/user-logs?page=1&per_page=20"
          }
        }
      ]
    }
  ]
}
